# =============================================================================
# LLM —— OpenAI 兼容协议（POST {LLM_BASE_URL}/chat/completions）
# 用法：从下面 6 个供应商预设里选一个，取消对应注释、填上你自己的 key 即可。
# key 只放本地 .env（已被 .gitignore 忽略），不要提交 git、不要写进代码。
# 全部留空 + 不设 LLM_MODE 时 = mock/规则模式，无 key 也能跑通 demo 和测试。
# =============================================================================

# 模式：auto（有 key 或显式设了 LLM_BASE_URL 就走真实 LLM，否则规则）
#      mock（强制规则）| llm（强制真实 LLM，如本地 Ollama 免 key 场景）
LLM_MODE=auto
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
# 小模型【预留，尚未接线】：为意图分类等便宜任务准备，目前没有任何
# 代码读取它（见 src/shared/config.py 的 RESERVED 注释），填了也不生效。
# LLM_SMALL_MODEL=

# --- 预设 1：OpenAI -----------------------------------------------------------
# LLM_MODEL=gpt-4o-mini
# LLM_SMALL_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...（填你自己的）

# --- 预设 2：DeepSeek ---------------------------------------------------------
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...（填你自己的）

# --- 预设 3：通义千问（阿里云 DashScope，OpenAI 兼容模式） --------------------
# LLM_MODEL=qwen-plus
# LLM_SMALL_MODEL=qwen-turbo
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...（填你自己的）

# --- 预设 4：火山方舟（豆包） --------------------------------------------------
# 注意：旧版 doubao-seed-1-6-250615 已下线（Shutdown），不要再用。
# LLM_MODEL=doubao-seed-2-1-turbo-260628
# 更便宜可选 lite 版：LLM_MODEL=doubao-seed-2-0-lite-260428
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=...（填你自己的；也可以把 LLM_MODEL 写成方舟控制台的推理接入点 ep-xxx）

# --- 预设 5：Moonshot / Kimi --------------------------------------------------
# LLM_MODEL=moonshot-v1-8k
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-...（填你自己的）

# --- 预设 6：Ollama 本地（免 key） --------------------------------------------
# 先本地跑：ollama serve && ollama pull qwen2.5:7b
# LLM_MODE=llm
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=（留空即可）

# 当前生效值（默认 OpenAI 命名 + 空 key = 自动走规则/mock 兜底）：
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# OPENAI_API_KEY=（与 LLM_API_KEY 二选一，也会被读取）

# --- ASR（录音转逐字稿，src/agents/minutes/transcriber.py）---
# mock（默认）：不转写。只有 audio_url、没有逐字稿的会议会停在
#   needs_transcript，warning 里写明原因，不会假装生成纪要。
# faster-whisper：真实转写。需先装可选依赖（不在主依赖里，保持轻量）：
#   pip install -e ".[asr]"
#   模型在第一次转写时按需下载（默认 small，约 0.5GB，缓存到
#   ~/.cache/huggingface），import 代码不会触发下载。
# 说话人分离（pyannote）未做：ASR 段落的 speaker 是统一占位「发言人」，
#   会议 warnings 里会明确标注这一点。
ASR_ENGINE=mock
# 模型大小：tiny | base | small | medium | large-v3（越大越准也越慢；
# CPU 场景 small 是务实默认，large-v3 建议有 GPU 时再用）
ASR_MODEL=small
ASR_DEVICE=cpu
# int8 是 CPU 上的务实选择；GPU 可用 float16
ASR_COMPUTE_TYPE=int8
# zh（默认）| en | auto（自动检测）等 whisper 语言码
ASR_LANGUAGE=zh
# POST /meetings/{id}/audio 上传的录音存到这个目录（相对路径相对工作目录）
ASR_UPLOAD_DIR=data/uploads
# --- 豆包云端 ASR（ASR_ENGINE=volcano 时用，火山引擎录音文件识别）---
# 与本地 faster-whisper 二选一：云端是异步提交/查询，要等轮询，但
# 自带说话人分离，且长音频不用占本地 CPU。
# 硬约束（实测换来的，代码里会先拦）：
#   1) 只接受公网可访问的音频 URL，不收文件——本地文件请用
#      faster-whisper，或先把文件放到对象存储等公网地址；
#   2) 格式只支持 wav/mp3/ogg/spx/amr/aac/m4a。flac 不在支持列表：
#      提交 flac 不会被拒，而是服务端挂起直到超时，所以客户端先拦。
# 凭据来源：火山引擎控制台 -> 豆包语音（语音技术）-> 应用管理，
# 创建/打开应用后在「API 调用」信息里拿 App ID 与 Access Token。
VOLCANO_ASR_APP_ID=
VOLCANO_ASR_ACCESS_TOKEN=
# 注意：录音文件识别接口的鉴权只用上面两项，Secret Key 本接口用不到
# （它是旧版/其他语音接口的），这里留空占位即可，不要以为配了才生效。
VOLCANO_ASR_SECRET_KEY=
# 资源 ID：SeedASR 2.0 用 volc.seedasr.auc（默认，一般不用改）
VOLCANO_ASR_RESOURCE=volc.seedasr.auc
# 轮询间隔（秒）与单次请求同步等待上限（秒）：等待超过上限仍 pending 时
# 不再阻塞请求（诚实返回「仍在处理中」），任务 ID 已保存在会议记录上，
# 再次 /process 会按该 ID 续查，不重复提交。
VOLCANO_ASR_POLL_INTERVAL_SEC=5
VOLCANO_ASR_SYNC_WAIT_SEC=60
# 单次等待的硬上限（秒）：实际预算取 min(SYNC_WAIT, TIMEOUT)。长音频
# 靠「再次 /process 续查」收敛，一般不需要调大这两个值。
VOLCANO_ASR_TIMEOUT_SEC=1800

# --- Providers: mock | google | feishu / feishu_task | linear | trello | jira ---
CALENDAR_PROVIDER=mock
TASK_PROVIDER=mock
NOTIFY_PROVIDER=mock

# --- Google Calendar / Outlook (Microsoft Graph) ---
GOOGLE_CALENDAR_TOKEN=
OUTLOOK_ACCESS_TOKEN=

# --- Feishu (calendar + task + webhook notify; setup: docs/feishu-setup.md) ---
# 在飞书开放平台创建「企业自建应用」后，从应用的凭证页面复制：
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 日历 ID：用应用/用户 token 调 GET /open-apis/calendar/v4/calendars 查列表后填。
# tenant 模式只能写应用自己的日历；user 模式可写已 OAuth 授权用户的日历。
FEISHU_CALENDAR_ID=
# tenant | user（默认 tenant；user 模式需下面至少一个 token）
FEISHU_CALENDAR_AUTH=tenant
# 用户在飞书 OAuth 登录后取得；短期有效。不要把真实值提交到 git。
FEISHU_USER_ACCESS_TOKEN=
# 与 user_access_token 配套取得；有了它客户端可在 token 失效时自动刷新。
FEISHU_REFRESH_TOKEN=
# 在飞书群里添加「自定义机器人」后复制完整 hook 地址；开启签名校验时再填机器人安全设置里的密钥。
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# 内部 user_id -> 飞书 open_id 的 JSON 对象。open_id 可从通讯录接口/应用后台按成员查询，
# 例如：FEISHU_USER_MAP={"u-lisi":"ou_xxx","u-wangwu":"ou_yyy"}
FEISHU_USER_MAP=
# 无时区的日期/时间按此时区解释（任务 due 也用它；会议本身的日历事件优先用工具构造时传入的时区）。
DEFAULT_TIMEZONE=Asia/Shanghai
# 旧名兼容（新配置请用 FEISHU_WEBHOOK_URL）：
# FEISHU_WEBHOOK=

# --- Task systems ---
LINEAR_API_KEY=
TRELLO_API_KEY=
JIRA_BASE_URL=
JIRA_API_TOKEN=

# --- Notify ---
SLACK_WEBHOOK=

# --- Reminders（任务到期提醒，src/orchestrator/reminders.py）---
# 默认关闭：关闭时 API 不启动任何后台线程，行为与之前完全一致。
# 开启后 API 进程内用 APScheduler 每 REMINDER_SCAN_INTERVAL_MIN 分钟扫描
# 一次：到期前 REMINDER_LEAD_HOURS 小时内发「即将到期」、已逾期发「已逾期」，
# 每项只发一次（重复扫描幂等）。也可以不开调度器，手动触发一次扫描：
#   curl -X POST localhost:8000/reminders/run
# 通知通道由上面的 NOTIFY_PROVIDER 决定（mock 时返回 mock:true，不真发送）。
REMINDERS_ENABLED=false
REMINDER_SCAN_INTERVAL_MIN=30
REMINDER_LEAD_HOURS=24

# --- Gate timeouts（确认闸门超时，src/orchestrator/gate_timeouts.py）---
# 会议卡在 awaiting_minutes_confirmation / awaiting_tasks_confirmation
# 超过 GATE_TIMEOUT_HOURS 小时无人确认时，扫描器二选一处理（超时绝不
# 自动确认，这是红线）：
#   notify（默认）= 发一条升级提醒（注明会议、卡在哪个闸门、已等待
#     时长），同一次进入闸门只发一次；
#   reject = 会议转入既有的 minutes_rejected / tasks_rejected，驳回
#     记录 reason 写明 confirmation timeout，之后走既有重跑/重抽路径。
# 默认关闭调度：开启后 API 进程内每小时（GATE_TIMEOUT_SCAN_INTERVAL_MIN）
# 扫描一次。也可以不开调度器，手动触发：
#   curl -X POST localhost:8000/gate-timeouts/run
GATE_TIMEOUTS_ENABLED=false
GATE_TIMEOUT_HOURS=48
GATE_TIMEOUT_ACTION=notify
GATE_TIMEOUT_SCAN_INTERVAL_MIN=60

# --- Weekly summary（任务周报，src/orchestrator/weekly_summary.py）---
# 汇总全部会议近 7 天的任务（本周到期/逾期未完成/未定日期/本周已完成），
# 经 NOTIFY_PROVIDER 发送。默认关闭调度：开启后每周一 09:00
# （DEFAULT_TIMEZONE 时区）自动生成发送。也可以手动触发并拿到全文：
#   curl -X POST "localhost:8000/weekly-summary/run?window_days=7"
WEEKLY_SUMMARY_ENABLED=false

# --- Storage ---
# 留空 = 内存模式（InMemoryDB）：零依赖可跑，但进程重启后会议数据全丢。
# 填 postgresql://... = Postgres 持久化（PostgresDB，表 meetings 自动建）：
# 重启不丢数据。docker compose 部署时 api 服务已默认指向 compose 内的
# postgres 服务（environment 覆盖），一般不用在这里再填。
# 本地示例（用户/库名与 docker-compose.yml 的 postgres 服务一致，
# 密码填 compose 里的本地开发默认值）：
# DATABASE_URL=postgresql://meeting:***@localhost:5432/meeting_agent
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# --- Access auth（HTTP Basic 认证，src/api/main.py 中间件）---
# 两项都填才启用；任一为空 = 不启用（与历史行为一致，本机 demo/测试
# 零配置不受影响）。启用后整个服务（全部 API + 网页 UI）都需要 Basic
# 认证，浏览器原生弹窗即可，只有 /health 保留开放供探活。部署到公网/
# 共享网络前务必启用（未启用时启动日志有醒目 warning）。详见 docs/security.md。
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# fail-closed 开关：true 时两项凭据缺任一即拒绝启动（对非本机部署推荐
# 一并设置，杜绝"忘了配凭据就上公网"的配置事故）。
REQUIRE_AUTH=false
